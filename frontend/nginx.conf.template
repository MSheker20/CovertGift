# ${API_TARGET} başlangıçta ortam değişkeninden doldurulur (ör. https://API_INTERNAL_FQDN).

# Vite parmak izli dosyaları uzun süre önbelleğe alınır; HTML ve API yanıtları alınmaz.
# Başlıklar sunucu düzeyinde kalır; location içindeki add_header güvenlik başlıklarını silerdi.
map $uri $cache_control {
    ~^/assets/ "public, max-age=31536000, immutable";
    default    "no-cache";
}

# Davet token'ı yolda taşınır (/invite/<token> SPA rotası ve /api/v1/invites/<token> API rotası).
# Bu istekler erişim loguna yazılmaz. Karar özgün istek yoluna ($request_uri) göre verilir: SPA
# rotası try_files ile /index.html'e iç yönlendirme yaptığı için location içindeki "access_log off"
# işe yaramaz (log, isteği sonlandıran location'ın ayarıyla yazılır).
map $request_uri $loggable {
    ~^/invite/          0;
    ~^/api/v1/invites/  0;
    default             1;
}

server {
    listen 5173;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /var/log/nginx/access.log main if=$loggable;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control $cache_control always;

    # Geliştirme uçları (veritabanı sıfırlama) dışarıya hiç açılmaz.
    # Regex location'lar sırayla denenir; bu blok API bloğundan önce kalmalı. Düz prefix
    # location yazılırsa API regex'i önce eşleşir ve istek API'ye gider.
    location ~* ^/api/v1/dev(/|$) {
        default_type application/json;
        return 403 '{"success":false,"error":"Bu uç bu ortamda kapalıdır"}';
    }

    # Kapak ve profil fotoğrafı: yalnızca bu iki rota 1m'den büyük gövde kabul eder. Fotoğrafı tarayıcı
    # küçültür; API sınırı ikisinde de 2 MiB dosya + 64 KiB multipart zarfıdır, 3m küçük bir paydır
    # (aşan gövde burada 413). Genel API bloğundan önce kalmalı; diğer tüm rotalar 1m ile sınırlı kalır.
    location ~ ^/api/v1/(groups/[^/]+/cover|me/avatar)$ {
        proxy_pass ${API_TARGET};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 3m;
    }

    # Davet API rotası: erişim logu yukarıdaki map ile, hata logu burada kapatılır. Ayarlar genel API
    # bloğuyla aynı kalmalı (proxy_* ve client_max_body_size location'a özeldir, miras alınmaz).
    # Genel API bloğundan önce kalmalı (regex sırası).
    location ~ ^/api/v1/invites/ {
        # Hata logu istek satırını (token dahil) yazar; bu rotada yalnızca kritik hatalar loglanır.
        error_log /var/log/nginx/error.log crit;
        proxy_pass ${API_TARGET};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        client_max_body_size 1m;
    }

    location ~ ^/(api/|health$|swagger/|docs$) {
        proxy_pass ${API_TARGET};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Gemini önerisi 1–2 dakika sürebilir.
        proxy_read_timeout 180s;
        client_max_body_size 1m;
    }

    location /assets/ {
        try_files $uri =404;
    }

    # Tek sayfalık uygulama: bilinmeyen yollar index.html'e düşer.
    location / {
        try_files $uri /index.html;
    }
}
